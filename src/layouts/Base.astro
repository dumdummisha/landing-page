---
import { Font } from 'astro:assets'
import '../styles/tokens.css'
import '../styles/site.css'

interface Props {
  title: string
}

const { title } = Astro.props
// Link-preview crawlers read the Open Graph tags as they are, so they need the absolute public address. The preview
// image must be a PNG or JPG: Slack does not render SVG.
const siteOrigin = 'https://dumdummisha.ai'
const description =
  'Dumdum Misha is your personal AI assistant that takes routine work off you in Slack and brings you the decisions. Runs on your computer. Invite-only pilot.'
const previewImage = `${siteOrigin}/og-image.png`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dumdum Misha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, siteOrigin).href} />
    <meta property="og:image" content={previewImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Dumdum Misha, a yellow blob with two eyes and a tooth" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={previewImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-sans" preload={[{ style: 'normal' }]} />
    <Font cssVariable="--font-mono" />
    <Font cssVariable="--font-hand" />
  </head>
  <body>
    <slot />
  </body>
</html>
