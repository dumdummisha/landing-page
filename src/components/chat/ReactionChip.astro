---
// The "I'm on it" reaction under a message, added from your account, so it carries your highlight.
import Reaction from '../mascot/Reaction.astro'
---

<span class="dd-react"><Reaction name="looking" size={16} />1</span>

<style>
  .dd-react {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 8px;
    margin-right: 6px;
    padding: 2px 9px;
    background: var(--misha);
    font: 600 12px/18px var(--font-sans);
  }
</style>
