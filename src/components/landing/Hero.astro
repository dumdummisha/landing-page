---
import Button from '../actions/Button.astro'
import Chat from '../chat/Chat.astro'
import CloneMark from '../chat/CloneMark.astro'
import Message from '../chat/Message.astro'
import Mascot from '../mascot/Mascot.astro'
import Nav from '../navigation/Nav.astro'
import Scribble from '../quirks/Scribble.astro'
import InviteButton from './InviteButton.astro'
import PriyaAsks from './PriyaAsks.astro'

const LINKS = [
  { href: '#does', label: 'What I do' },
  { href: '#how', label: 'How it works' },
  { href: 'https://docs.dumdummisha.ai/start/why', label: 'Docs' },
  { href: '#faq', label: 'FAQ' },
]
---

<div class="dd-yellow" style="position:relative;overflow:hidden">
  <Nav links={LINKS} isFullName><InviteButton size="sm" /></Nav>
  <header class="dd-hero">
    <div class="dd-wrap dd-hero__grid">
      <div>
        <h1 class="display-xl">Dumber than you, helpful <span class="dd-mark">enough.</span></h1>
        <p class="body-l dd-hero__sub">
          I'm Dumdum Misha, a personal AI agent for the routine work that reaches you in Slack. I answer the questions,
          take on the small jobs, and bring you the decisions that need you.
        </p>
        <p class="dd-hero__access">
          I run on your computer and work through the Slack you're already signed in to. No Slack app for an admin to
          approve, and no Dumdum Misha server. Your AI provider does the thinking, under your own account.
        </p>
        <div class="dd-hero__cta">
          <InviteButton size="lg" />
          <Button href="https://docs.dumdummisha.ai/start/why" variant="secondary" size="lg">Read the docs</Button>
        </div>
        <p class="dd-hero__pilot">Invite-only pilot. Free for now, on your own Claude subscription.</p>
      </div>
      <div style="position:relative">
        <Chat title="# shop-backend">
          <PriyaAsks />
          <Message initials="SR" name="Sam Rivera" time="09:12" isInThread>
            <div class="dd-m__t"><CloneMark />I'm on it, SHOP-142.</div>
            <div class="dd-m__t">I'll post here when it's on dev.</div>
          </Message>
        </Chat>
        <div class="dd-peek" style="transform:rotate(var(--tilt-4));right:-36px;bottom:-104px">
          <Mascot size={150} isLabelled />
        </div>
        <Scribble class="dd-hero__note">
          hi. I built this page.
          <svg slot="arrow" viewBox="0 0 80 56" width="64" height="44" aria-hidden="true">
            <path d="M4 30 C 24 20, 44 38, 74 26"></path><path d="M74 26 L61 18 M74 26 L62 37"></path>
          </svg>
        </Scribble>
      </div>
    </div>
  </header>
</div>

<style>
  .dd-hero {
    padding: var(--space-7) 0 var(--space-10);
  }

  .dd-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-9);
    align-items: center;
  }

  .dd-hero h1 {
    margin-bottom: var(--space-5);
  }

  .dd-hero__sub {
    max-width: 500px;
    color: var(--ink-muted);
  }

  .dd-hero__access {
    max-width: 500px;
    margin-top: var(--space-4);
    font: 400 15px/22px var(--font-sans);
  }

  .dd-hero__pilot {
    margin-top: var(--space-4);
    font: 400 13px/18px var(--font-mono);
    color: var(--ink-muted);
  }

  .dd-hero__cta {
    display: flex;
    gap: var(--space-5);
    align-items: center;
    margin-top: var(--space-7);
    flex-wrap: wrap;
  }

  .dd-mark {
    position: relative;
    display: inline-block;
    z-index: 0;
  }

  .dd-mark::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 12px;
    right: -8px;
    top: 0.34em;
    bottom: -0.12em;
    background: var(--misha);
  }

  .dd-yellow .dd-mark::before {
    background: var(--surface-200);
  }

  /* The note points to the face; hide both at the same phone breakpoint. */
  .dd-hero :global(.dd-hero__note) {
    position: absolute;
    right: 112px;
    bottom: -96px;
  }

  @media (max-width: 760px) {
    .dd-hero {
      padding-bottom: var(--space-7);
    }

    .dd-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .dd-hero :global(.dd-hero__note) {
      display: none;
    }

    /* The buttons are their own components, so the scoped rule has to reach into them. */
    .dd-hero__cta :global(.dd-btn--lg) {
      padding: 18px 24px;
    }
  }
</style>
