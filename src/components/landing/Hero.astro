---
import Button from '../actions/Button.astro'
import Mascot from '../mascot/Mascot.astro'
import Nav from '../navigation/Nav.astro'
import Scribble from '../quirks/Scribble.astro'
import HeroScenes from './HeroScenes.astro'
import InviteButton from './InviteButton.astro'

const LINKS = [
  { href: '#does', label: 'What I do' },
  { href: '#how', label: 'How it works' },
  { href: 'https://docs.dumdummisha.ai/start/try', label: 'Docs' },
  { href: '#faq', label: 'FAQ' },
]
---

<div class="dd-yellow" style="position:relative;overflow:hidden">
  <Nav links={LINKS}><InviteButton size="sm" /></Nav>
  <header class="dd-hero">
    <div class="dd-wrap dd-hero__grid">
      <div>
        <h1 class="display-xl">Dumber than you, helpful <span class="dd-mark">enough.</span></h1>
        <p class="body-l dd-hero__sub">
          Your personal AI assistant for the routine work that reaches you in Slack. It answers the questions, takes on
          the small jobs and brings you only the decisions that need you.
        </p>
        <div class="dd-hero__cta">
          <InviteButton size="lg" />
          <Button
            href="https://calendly.com/michal-dumdummisha/30min"
            target="_blank"
            rel="noopener noreferrer"
            variant="secondary"
            size="lg"
            >Book a call with Michal<span class="dd-vh"> (opens in a new tab)</span></Button
          >
        </div>
        <p class="dd-hero__pilot">Invite-only pilot. Runs on your own Claude subscription, or on OpenAI through OpenCode (Claude Code still needs to be on your Mac).</p>
      </div>
      <div style="position:relative">
        <HeroScenes />
        <div class="dd-peek" style="transform:rotate(var(--tilt-4));right:-36px;bottom:-104px">
          <Mascot size={150} isLabelled />
        </div>
        <Scribble class="dd-hero__note">
          hi. I built this page.
          <svg slot="arrow" viewBox="0 0 80 56" width="64" height="44" aria-hidden="true">
            <path d="M4 30 C 24 20, 44 38, 74 26"></path><path d="M74 26 L61 18 M74 26 L62 37"></path>
          </svg>
        </Scribble>
      </div>
    </div>
  </header>
</div>

<style>
  .dd-hero {
    padding: var(--space-7) 0 var(--space-10);
  }

  .dd-hero__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: var(--space-9);
    align-items: center;
  }

  .dd-hero h1 {
    margin-bottom: var(--space-5);
  }

  .dd-hero__sub {
    max-width: 500px;
    color: var(--ink-muted);
  }

  .dd-hero__pilot {
    margin-top: var(--space-4);
    font: 400 13px/18px var(--font-mono);
    color: var(--ink-muted);
  }

  /* The two buttons stay on one line at every width: below the row they need at full size, the gap, their padding
     and their type shrink together with the row's own width, so the rule follows the row in both the one- and the
     two-column layout. Each size runs in a straight line from its floor, with the row at 288px (a 320px viewport,
     the narrowest common phone and WCAG's reflow width, less the 16px phone gutters), to the lg button's size, with
     the row at 502px (both labels at 18px, 317.87px measured, plus the lg padding and the 24px gap). The row's need
     is a straight line between the same two points and fits at both, so it fits at every width between them. The
     floors are the sm button's 14px/18px type, the base button's 16px vertical padding and space-2 for the
     horizontal padding and the gap. On a narrower row the buttons shrink into their padding (min-width: 0) instead
     of wrapping or widening the page. */
  .dd-hero__cta {
    container-type: inline-size;
    display: flex;
    /* In a flex gap, 100% is the row's width, the length 100cqi stands for in the buttons below. */
    gap: clamp(var(--space-2), calc(var(--space-2) + 16 * (100% - 288px) / 214), var(--space-5));
    align-items: center;
    margin-top: var(--space-7);
  }

  /* The buttons are their own components, so the scoped rule has to reach into them. --cta-grow is 0px with the row
     at 288px and 1px at 502px, so a size is its floor plus its range in px times --cta-grow. */
  .dd-hero__cta :global(.dd-btn--lg) {
    --cta-grow: calc((100cqi - 288px) / 214);
    flex: 0 1 auto;
    min-width: 0;
    padding: clamp(16px, calc(16px + 6 * var(--cta-grow)), 22px)
      clamp(var(--space-2), calc(var(--space-2) + 32 * var(--cta-grow)), 40px);
    font-size: clamp(14px, calc(14px + 4 * var(--cta-grow)), 18px);
    line-height: clamp(18px, calc(18px + 6 * var(--cta-grow)), 24px);
  }

  .dd-mark {
    position: relative;
    display: inline-block;
    z-index: 0;
  }

  .dd-mark::before {
    content: "";
    position: absolute;
    z-index: -1;
    left: 12px;
    right: -8px;
    top: 0.34em;
    bottom: -0.12em;
    background: var(--surface-200);
  }

  /* The note points to the face; hide both at the same phone breakpoint. */
  .dd-hero :global(.dd-hero__note) {
    position: absolute;
    right: 112px;
    bottom: -96px;
  }

  @media (max-width: 760px) {
    .dd-hero {
      padding-bottom: var(--space-7);
    }

    .dd-hero__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }

    .dd-hero :global(.dd-hero__note) {
      display: none;
    }
  }
</style>
