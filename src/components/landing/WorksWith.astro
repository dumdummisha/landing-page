---
import Band from '../band/Band.astro'
import SectionHead from '../band/SectionHead.astro'
import ToolChip from '../marketing/ToolChip.astro'
---

<Band tone="tint" id="works-with">
  <SectionHead eyebrow="Works with" title="Eight tools in the pilot.">
    More tools are one adapter away.
  </SectionHead>
  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;align-items:flex-start">
    <ToolChip name="Slack" icon="chat" drop={0} />
    <ToolChip name="Claude Code" icon="terminal" drop={14} />
    <ToolChip name="GitHub" icon="branch" drop={4} />
    <ToolChip name="Jira" icon="ticket" drop={18} />
    <ToolChip name="Figma" icon="frame" drop={8} />
    <ToolChip name="Fireflies" icon="microphone" drop={16} />
    <ToolChip name="Google Docs" icon="page" drop={2} />
    <ToolChip name="AWS" icon="cloud" drop={12} />
  </div>
</Band>

