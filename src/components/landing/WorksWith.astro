---
import Band from '../band/Band.astro'
import SectionHead from '../band/SectionHead.astro'
import ToolChip from '../marketing/ToolChip.astro'
---

<Band tone="tint" id="works-with">
  <SectionHead eyebrow="Works with" title="Your tools, plus eight of my own.">
    I work with the tools you've already connected on your computer. For these eight I bring my own small connectors,
    built for the job instead of the vendor's whole toolbox, so I do better work and spend fewer tokens.
  </SectionHead>
  <div style="display:flex;gap:var(--space-4);flex-wrap:wrap;align-items:flex-start">
    <ToolChip name="Slack" icon="chat" drop={0} />
    <ToolChip name="GitHub" icon="branch" drop={14} />
    <ToolChip name="Jira and Confluence" icon="ticket" drop={4} />
    <ToolChip name="Figma" icon="frame" drop={18} />
    <ToolChip name="Fireflies (meeting notes)" icon="microphone" drop={8} />
    <ToolChip name="Google Workspace" icon="page" drop={16} />
    <ToolChip name="AWS" icon="cloud" drop={2} />
    <ToolChip name="Browser control" icon="laptop" drop={12} />
  </div>
</Band>
