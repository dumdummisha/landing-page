---
import NewTabLink from '../actions/NewTabLink.astro'
import Mascot from '../mascot/Mascot.astro'
import InviteButton from './InviteButton.astro'
---

<section class="dd-yellow dd-want">
  <div class="dd-wrap">
    <h2 class="display-xl">Want in?</h2>
    <p class="body-l dd-want__note">
      The pilot is invite-only. Ask Michal for a place. It runs on your own Claude subscription through Claude Code, or on OpenAI through OpenCode. Either one is enough.
    </p>
    <div class="dd-want__cta">
      <InviteButton size="lg" />
      <NewTabLink href="https://docs.dumdummisha.ai/start/try">Read the docs first</NewTabLink>
      <span>
        <NewTabLink href="https://github.com/dumdummisha/desktop-downloads/releases/latest"
          >Download for Mac (Apple silicon)</NewTabLink
        >
        <span class="dd-muted">Needs an invite to use</span>
      </span>
    </div>
  </div>
  <div class="dd-peek" style="transform:rotate(var(--tilt-4));right:56px;bottom:-120px"><Mascot size={300} isLabelled /></div>
</section>

<style>
  .dd-want {
    position: relative;
    overflow: hidden;
    padding: var(--space-10) 0;
  }

  .dd-want__note {
    max-width: 480px;
    margin-top: var(--space-5);
  }

  .dd-want__cta {
    display: flex;
    gap: var(--space-6);
    align-items: center;
    flex-wrap: wrap;
    margin-top: var(--space-7);
    font: 500 15px/20px var(--font-sans);
  }

  .dd-want__cta a:not(.dd-btn) {
    color: var(--ink);
  }

  @media (max-width: 760px) {
    .dd-want {
      padding: var(--space-8) 0;
    }
  }
</style>
