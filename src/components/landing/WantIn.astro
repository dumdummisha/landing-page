---
import Mascot from '../mascot/Mascot.astro'
import InviteButton from './InviteButton.astro'
---

<section class="dd-yellow dd-want">
  <div class="dd-wrap">
    <h2 class="display-xl">Want in?</h2>
    <div style="margin-top:var(--space-7)"><InviteButton size="lg" /></div>
  </div>
  <div class="dd-peek" style="transform:rotate(var(--tilt-4));right:56px;bottom:-120px"><Mascot size={300} isLabelled /></div>
</section>

<style>
  .dd-want {
    position: relative;
    overflow: hidden;
    padding: var(--space-10) 0;
  }

  @media (max-width: 760px) {
    .dd-want {
      padding: var(--space-8) 0;
    }
  }
</style>
