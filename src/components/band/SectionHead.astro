---
// A landing section's eyebrow, heading and optional lead paragraph (the slot).
interface Props {
  eyebrow: string
  title: string
}

const { eyebrow, title } = Astro.props
---

<div class="dd-section__head">
  <div class="dd-eyebrow">{eyebrow}</div>
  <h2 class="heading-1" style="margin-top:8px">{title}</h2>
  {Astro.slots.has('default') && <p class="body-l"><slot /></p>}
</div>

<style>
  .dd-section__head {
    max-width: var(--size-lead);
    margin-bottom: var(--space-8);
  }

  .dd-section__head p {
    margin-top: var(--space-4);
    color: var(--ink-muted);
  }

  @media (max-width: 760px) {
    .dd-section__head {
      margin-bottom: var(--space-6);
    }
  }
</style>
