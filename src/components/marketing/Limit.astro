---
// One line of the limits list: what I never do, in bold, and the plain-words reason in the slot.
import type { ComponentProps } from 'astro/types'
import Icon from '../Icon.astro'

interface Props {
  icon: ComponentProps<typeof Icon>['name']
  title: string
}

const { icon, title } = Astro.props
---

<li>
  <div class="dd-wont__ico"><Icon name={icon} /></div>
  <div>
    <b>{title}</b>
    <p><slot /></p>
  </div>
</li>

<style>
  li {
    display: grid;
    grid-template-columns: 44px 1fr;
    gap: var(--space-5);
    padding: var(--space-5) 0;
  }

  b {
    font: 600 22px/30px var(--font-display);
  }

  p {
    color: var(--ink-muted);
    font: 400 16px/24px var(--font-sans);
    margin-top: 2px;
  }

  .dd-wont__ico {
    width: 44px;
    height: 44px;
    background: var(--surface-200);
    display: grid;
    place-items: center;
  }
</style>
