---
// The brand in the navigation and the footer. Its full name is the landing page's alone; every other page calls the
// clone Misha.
interface Props {
  isFullName?: boolean
}

const { isFullName = false } = Astro.props
---

<a class="dd-brand" href="/">{isFullName ? 'Dumdum Misha' : 'Misha'}</a>

<style>
  .dd-brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font: 600 20px/24px var(--font-display);
    letter-spacing: -0.01em;
    color: var(--ink) !important;
    text-decoration: none;
  }
</style>
